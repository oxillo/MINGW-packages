# Maintainer: Olivier XILLO <oxdev_at_mailo.com>

_realname=cpp-jwt
pkgbase=mingw-w64-${_realname}
pkgname="${MINGW_PACKAGE_PREFIX}-${_realname}"
pkgver=1.5.1
pkgrel=1
pkgdesc='JSON Web Token library for C++'
arch=('any')
mingw_arch=('mingw64' 'ucrt64' 'clang64')
license=('spdx:MIT')
url="https://github.com/arun11299/cpp-jwt"
makedepends=("${MINGW_PACKAGE_PREFIX}-cc"
             "${MINGW_PACKAGE_PREFIX}-cmake"
             "${MINGW_PACKAGE_PREFIX}-ninja"
             'git')
_commit='b7f1717'
source=("${_realname}::git+https://github.com/arun11299/${_realname}.git#commit=${_commit}")
sha256sums=('SKIP')

pkgver() {
  cd "${srcdir}/${_realname}"
  git describe --tags "${_commit}" | sed 's/^v//g'
}

prepare() {
  cd "${srcdir}/${_realname}"
}

build(){
  declare -a extra_config
  if check_option "debug" "n"; then
    extra_config+=("-DCMAKE_BUILD_TYPE=Release")
  else
    extra_config+=("-DCMAKE_BUILD_TYPE=Debug")
  fi

  MSYS2_ARG_CONV_EXCL="-DCMAKE_INSTALL_PREFIX=" \
  cmake \
    -GNinja \
    -DCMAKE_INSTALL_PREFIX="${MINGW_PREFIX}" \
    "${extra_config[@]}" \
    -DBUILD_SHARED_LIBS=ON \
    -S "${_realname}" \
    -B "build-${MSYSTEM}"
    
  cmake --build "build-${MSYSTEM}"
}

check() {
  echo "nothing to do"
}

package() {
  DESTDIR="${pkgdir}" cmake --install "build-${MSYSTEM}"

  install -Dm644 "${srcdir}/${_realname}/LICENSE" "${pkgdir}${MINGW_PREFIX}/share/licenses/${_realname}/LICENSE"
}
